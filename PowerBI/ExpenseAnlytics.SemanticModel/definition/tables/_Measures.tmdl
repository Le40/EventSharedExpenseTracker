table _Measures
	lineageTag: 148aafd5-7b0f-4bba-a221-3ee40057915a

	measure 'User Balance EUR' = [User Paid in EUR] - [User Consumption in EUR]
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: d2221f2a-411c-446d-8c7a-b13e2fecb026

		annotation PBI_FormatHint = {"currencyCulture":"sk-SK"}

	measure 'Total Expenses EUR' = SUM(FactExpenses[ExpenseAmountBase])
