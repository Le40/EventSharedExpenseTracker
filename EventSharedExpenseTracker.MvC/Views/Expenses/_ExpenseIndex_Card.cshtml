@using EventSharedExpenseTracker.Domain.Enums
@using EventSharedExpenseTracker.MvC.Common
@using EventSharedExpenseTracker.MvC.ViewModels.Expenses

@model ExpenseListItemViewModel

<li class="list-group-item expense-card" data-list-item>
    <div data-expense-card="true"
         data-restorable="true">

        <div role="button"
             data-bs-toggle="collapse"
             data-bs-target="#owed-details-@Model.Id"
             aria-expanded="false"
             aria-controls="owed-details-@Model.Id">

            <div class="d-flex justify-content-between gap-3">
                <div class="min-w-0">
                    <h5 class="mb-1" data-expense-name>@Model.Name</h5>

                    <small class="text-white-50" data-expense-category>
                        @Model.Category.GetDisplayName()
                    </small>
                </div>

                <div class="text-end flex-shrink-0">
                    <div class="fw-bold" data-expense-amount>
                        @if (Model.TotalPaidBase == Model.TotalPaidOriginal)
                        {
                            @CurrencyFormatter.FormatMoney(Model.TotalPaidBase)
                        }
                        else
                        {
                            @($"{CurrencyFormatter.FormatMoney(Model.TotalPaidOriginal)} / {CurrencyFormatter.FormatMoney(Model.TotalPaidBase)}")
                        }
                    </div>

                    <small class="text-muted" data-expense-date>
                        @Model.Date.ToShortDateString()
                    </small>
                </div>
            </div>

            <div class="mt-2 text-white-50 small">
                Paid by:
                <span data-expense-paid-by>
                    @foreach (var payment in Model.PaidPayments)
                    {
                        <span class="border border-light-subtle rounded bg-dark px-1 me-1">
                            @payment.ParticipantName
                        </span>
                    }
                </span>

                <span data-expense-owed-count>
                    for @(Model.OwedPayments.Count() == 1 ? "1 person" : $"{Model.OwedPayments.Count()} people")
                </span>
            </div>
        </div>

        <div class="collapse mt-2" id="owed-details-@Model.Id">
            <div class="border-top border-secondary pt-2 d-flex align-items-end gap-2">

                <div class="d-flex flex-wrap gap-2 small flex-grow-1">
                    @foreach (var owed in Model.OwedPayments)
                    {
                        <span class="border border-light-subtle rounded bg-dark text-white-50 px-2 py-1">
                            @owed.ParticipantName: @CurrencyFormatter.Format(owed.AmountBase, Model.CurrencyCode)
                        </span>
                    }
                </div>

                <button type="button"
                        class="btn btn-sm btn-outline-secondary flex-shrink-0"
                        data-requires-server="true"
                        hx-get="@Url.Action("Edit", "Expenses", new { id = Model.Id })"
                        hx-target="#appOffCanvasBody"
                        data-offcanvas-title="Edit Expense">
                    Edit
                </button>

            </div>
        </div>
    </div>
</li>