@using EventSharedExpenseTracker.MvC.ViewModels.Expenses
@using EventSharedExpenseTracker.Domain.Enums
@using EventSharedExpenseTracker.MvC.Common

@model ExpenseIndexViewModel

@{
    Layout = null;
}

<div id="@Model.EIdExpenseCollection" onload="autoFocus()">
    <div class="row expense-controls-sticky bg-body">
        <div class="col-auto pe-1">
            <div class="d-flex h-100 gap-2">
                @* ADD EXPENSE *@
                @*<button class="btn btn-sm btn-outline-warning w-100 h-100 rounded d-none d-md-flex"*@
                <button class="btn btn-info btn-sm trip-action-btn"
                        hx-get="@Url.Action("Create", "Expenses", new { tripId = Model.TripId })"
                        hx-target="#@Model.EIdCreateExpense">
                    <span class="d-none d-md-inline"
                          style="font-size:1.5rem; line-height:1;">
                        ✛
                    </span>

                    <span class="d-md-none fw-bold fs-1">
                        ✛
                    </span>
                </button>

                <form asp-action="ParseReceipt" enctype="multipart/form-data" class="d-flex m-0">
                    <label id="receiptUploadButton" for="receipt-upload" class="btn btn-outline-info btn-sm trip-action-btn">
                        <span class="emoji">📷</span>
                        <span class="d-none d-md-inline">Scan</span>
                    </label>
                    <input id="receipt-upload" class="d-none"
                           type="file"
                           name="receiptImage"
                           accept="image/*"
                           capture="environment"
                           hx-post="/Expenses/ParseReceipt"
                           hx-vals='{"tripId": "@Model.TripId"}'
                           hx-trigger="change"
                           hx-encoding="multipart/form-data"
                           hx-target="#@Model.EIdCreateExpense" />
                </form>

            </div>
        </div>

        <div class="col ps-1">
            <div class="btn-group d-flex flex-wrap align-content-center h-100">
                @*SORT BY NAME*@
                @*<button type="button" class="btn btn-sm btn-outline-secondary"
                        data-requires-online="true"
                        hx-get="@Url.Action("Index", "Expenses", new { tripId = Model.TripId, sortOrder = Model.NameSortParam, searchString = Model.SearchString, creator = Model.Creator, categoryFilter = Model.CategoryFilter })"
                        hx-target="#@Model.EIdExpenseCollection">
                    Name
                </button>*@
                @*SORT BY DATE*@
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        data-requires-online="true"
                        hx-get="@Url.Action("Index", "Expenses", new { tripId = Model.TripId, sortOrder = Model.DateSortParam, searchString = Model.SearchString, creator = Model.Creator, categoryFilter = Model.CategoryFilter })"
                        hx-target="#@Model.EIdExpenseCollection">
                    Date
                </button>
                @*SORT BY AMOUNT - sqlite not working*@
                <button type="button" class="btn btn-sm btn-outline-secondary d-none d-lg-inline-block"
                        data-requires-online="true"
                        hx-get="@Url.Action("Index", "Expenses", new { tripId = Model.TripId, sortOrder = Model.AmountSortParam, searchString = Model.SearchString, creator = Model.Creator, categoryFilter = Model.CategoryFilter })"
                        hx-target="#@Model.EIdExpenseCollection">
                    Amount
                </button>
                @*FILTER BY CATEGORY*@
                <select id="categoryDropdown" class="btn btn-sm btn-outline-secondary w-auto"
                        data-requires-online="true"
                        asp-for="CategoryFilter"
                        asp-items="@Html.GetEnumSelectList<ExpenseCategory>()"
                        name="categoryFilter"
                        hx-get="@Url.Action("Index", "Expenses", new { tripId = Model.TripId, sortOrder = Model.CurrentSort, searchString = Model.SearchString, creator = Model.Creator })"
                        hx-target="#@Model.EIdExpenseCollection">
                    <option value="">Category</option>
                </select>
                @*FILTER BY CREATED BY USER*@
                <button type="button"
                        data-requires-online="true"
                        class="btn btn-sm btn-outline-secondary @(Model.Creator ? "active" : "")"
                        hx-get='@Url.Action("Index", "Expenses", new { tripId = Model.TripId, sortOrder = Model.CurrentSort, searchString = Model.SearchString, creator = !Model.Creator, categoryFilter = Model.CategoryFilter })'
                        hx-target="#@Model.EIdExpenseCollection"
                        hx-swap="outerHTML">
                    Mine
                </button>
                @*SEARCH*@
                <input type="text" id="searchInput" name="searchString" autocomplete="off" placeholder="search expense" value="@Model.SearchString" class="btn btn-sm btn-outline-secondary bg-secondary-subtle w-auto"
                       data-requires-online="true"
                       hx-get="@Url.Action("Index", "Expenses", new { tripId = Model.TripId, sortOrder = Model.CurrentSort, creator = Model.Creator, categoryFilter = Model.CategoryFilter })"
                       hx-target="#@Model.EIdExpenseCollection"
                       hx-trigger="keyup changed delay:500ms" />
            </div>
        </div>


        <ul class="list-group list-group-flush px-2"
            data-expense-list="true"
            data-trip-id="@Model.TripId">

            <li class="list-group-item" id="@Model.EIdCreateExpense"
                data-expense-create-row="true"
                data-restorable="true">
            </li>
        </ul>
    </div>

     <ul class="list-group list-group-flush"
            data-expense-list="true"
            data-trip-id="@Model.TripId">


        @foreach (var expense in Model.Expenses)
        {
            <partial name="~/Views/Expenses/_ExpenseIndex_Card.cshtml" model="expense" />
        }
    </ul>
</div>
