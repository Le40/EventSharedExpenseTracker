@using EventSharedExpenseTracker.MvC.Common
@using EventSharedExpenseTracker.MvC.ViewModels.Trips
@model TripDetailsViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    ViewData["Title"] = @Html.DisplayFor(model => model.Name);
    var requestToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    int randRotate = new Random().Next(1, 5);
}

@*PEOPLE + EXPENSES*@
<div class="row mb-1" id="tripDetails-target">
    <div class="details-card-wrapper">

        <div class="photo-card photo-card--details card shadow bg-light border-0 rounded-0 p-2 mb-3"
             style="--trip-color:@TripCategoryUiMetadata.Categories[Model.Category].Color">

            @*PHOTO CARD*@
            <partial name="_TripDetails_Photo" model="Model" />

            @*TRIP CONTROLS*@
            @if (Model.CanUserEdit)
            {
                <partial name="_TripDetails_Controls" model="Model" />
            }

            <div id="@Model.EIdSearchParticipants" class="d-flex flex-wrap gap-1 mt-2">
                @*DIV FOR SEARCH RESULTS*@
            </div>

            @*PARTICIPANTS*@
            <partial name="_TripDetails_Participants" model="Model.TripParticipants" />
           
            <small class="text-muted">
               double click to delete user or edit expense
            </small>
        </div>
    </div>


    @*COL OF EXPENSES*@
    <div class="col" style="min-width: 330px; min-height: 750px; max-height: 750px;overflow-y: auto;">
        <section>
                <partial name="~/Views/Expenses/_ExpenseIndex.cshtml" model="Model.ExpenseIndex" />
        </section>
    </div>
</div>



