@using EventSharedExpenseTracker.MvC.Common
@using EventSharedExpenseTracker.MvC.ViewModels.Trips 
@model TripIndexViewModel

@{
    ViewData["Title"] = "Index";
    Random rnd = new Random();
    string[] rotations = ["-1.75deg", "-1.25deg", "-1deg", "-0.75deg","-0.5deg","-0.25deg","0.deg", "0.25deg", "0.5deg", "0.75deg", "1deg", "1.25deg", "1.75deg"];
}

<div class="container-fluid">
    <div class="row">
        @*CARD FOR CREATING NEW TRIP*@
        <div class="col-auto p-2-5">

            <div class="photo-card-slot rounded-0 p-2"
                 hx-get="@Url.Action("Create", "Trips")"
                 hx-target="#@Model.EIdCreateTrip"
                 hx-trigger="click once">

                <div class="photo-corner top-left"></div>
                <div class="photo-corner top-right"></div>
                <div class="photo-corner bottom-left"></div>
                <div class="photo-corner bottom-right"></div>

                <div id="@Model.EIdCreateTrip">

                    @*<div class="photo-card-font text-white d-flex flex-column justify-content-center align-items-end">*@
                    <h2 class="photo-card-font text-end"
                        style="transform: translateY(30px)">+ Trip to be</h2>
                    @*</div>*@
                </div>
         
            </div>

            @*<div class="photo-card photo-card--small card border-0 rounded-0 p-2">


                <div id="@Model.EIdCreateTrip"
                     hx-get="@Url.Action("Create", "Trips")"
                     hx-trigger="click once">

                    <svg class="bd-placeholder-img card-img-top rounded-0" width="200" height="200" role="img">
                        <rect width="100%" height="100%" fill="#332D2D"></rect>
                    </svg>

                    <div class="photo-card-font card-img-overlay text-white d-flex flex-column justify-content-center align-items-end">
                        <h2 class="card-title m-0">+ Trip to be</h2>
                    </div>
                </div>

            </div>*@
        </div>

        @*REST OF TRIP CARDS*@
  
        @foreach (var trip in Model.Trips)
        {
            var categoryInfo = TripCategoryUiMetadata.Categories[trip.Category];
            var imagePath = trip.ImagePath != null
                ? Url.Content(trip.ImagePath)
                : Url.Content(categoryInfo.DefaultImagePath);

            var randRotateDeg = rotations[rnd.Next(rotations.Length)];
            <div class="col p-2-5 event-grid photo-card-font">
                <div class="photo-card photo-card--small border-0 rounded-0 p-2"
                     style="
                        --trip-color:@categoryInfo.Color;
                        --rotation:@randRotateDeg;">

                    <div class="photo-corner top-left"></div>
                    <div class="photo-corner top-right"></div>
                    <div class="photo-corner bottom-left"></div>
                    <div class="photo-corner bottom-right"></div>


                    <a href="@Url.Action("Details", "Trips", new { id = trip.Id })" class="stretched-link"></a>
                    <div class="position-relative">
                        <div class="photo-card-media border border-secondary">

                            <img src="@imagePath"
                                 alt="image"
                                 class="card-img-top rounded-0">
                        </div>

                        <div class="position-absolute bottom-0 end-0 text-white p-2">
                            <div class="photo-card-title text-end m-0">@Html.DisplayFor(modelItem => trip.Name)</div>
                            <div class="photo-card-subtitle title text-end m-0">@trip.DateFrom.ToString("MMMM yyyy")</div>

                        </div>
                    </div>

                    <i class="photo-card-font bg-white text-dark">
                        @string.Join(", ", trip.ParticipantNames)
                    </i>

                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}


