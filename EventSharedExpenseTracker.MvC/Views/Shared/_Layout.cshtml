@using Microsoft.AspNetCore.Identity
@using EventSharedExpenseTracker.Infrastructure.Identity
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ESET</title>

    <link rel="manifest" href="/manifest.json" />

    <link href="https://fonts.cdnfonts.com/css/unseeness" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/photo-cards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-controls.css" asp-append-version="true" />

    <script src="https://unpkg.com/htmx.org@1.9.10/dist/htmx.min.js"></script>
</head>

<body hx-boost="false">
    <header id="site-header" class="bg-dark border-bottom box-shadow mb-3 sticky-top">
        <div class="container-fluid pt-2 pb-0">

            @if (SignInManager.IsSignedIn(User))
            {

                <div class="d-flex align-items-end flex-wrap gap-2">
                    <!-- Navigation row -->
                    <nav class="nav nav-tabs nav-row">
                        <a class="nav-link app-tab active"
                           asp-controller="Trips"
                           asp-action="Index">
                            Events
                        </a>
                        @*<a class="nav-link app-tab active"
                           asp-controller="Friends"
                           asp-action="Index">
                            Friends
                        </a>*@
                        @*<a class="nav-link app-tab">Expenses</a>
                        <a class="nav-link app-tab">Friends</a>
                        <a class="nav-link app-tab">Settings</a>*@
                     </nav>

                        @*<nav class="app-tabs mt-2">
                        <a class="nav-link app-tab"
                           asp-controller="Trips"
                           asp-action="Index">
                            Trips
                        </a>

                        <a class="nav-link app-tab"
                           asp-controller="Expenses"
                           asp-action="Index">
                            Expenses
                        </a>

                        <a class="nav-link app-tab"
                           asp-controller="Friends"
                           asp-action="Index">
                            Friends
                        </a>

                        <a class="nav-link app-tab"
                           asp-controller="Settings"
                           asp-action="Index">
                            Settings
                        </a>
                        </nav>*@

                    <!-- Top status/account row -->
                    <div class="navbar-actions">
                            <div>
                                <span id="connectionStatus"
                                  class="badge rounded-pill bg-danger d-none">
                                    Offline Mode
                                </span>

                                <span id="failedValidationBadge"
                                      class="badge rounded-pill bg-danger d-none">
                                    0 Review
                                </span>

                                <span id="pendingSyncBadge"
                                      class="badge rounded-pill bg-warning text-dark d-none">
                                    0 Pending
                                </span>

                                <button id="syncNowButton"
                                        type="button"
                                        class="btn btn-sm btn-outline-warning d-none">
                                    Sync
                                </button>

                                <button id="installAppButton"
                                        type="button"
                                        class="btn btn-sm btn-outline-info d-none">
                                    Install
                                </button>
                            </div>

                            <div class="navbar-account">
                                <partial name="_LoginPartial" />
                            </div>
                    </div>
                </div>
            }
            else
            {
                <div class="navbar-account">
                    <partial name="_LoginPartial" />
                </div>
            }
        </div>
    </header>

    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
        @*SIDE PANEL FOR SEARCH*@
        <div id="appBottomSheet" class="app-bottom-sheet">
            <div class="app-bottom-sheet-header">
                <button type="button"
                        class="btn btn-sm btn-outline-light"
                        data-close-bottom-sheet>
                    Close
                </button>
            </div>

            <div id="appBottomSheetBody" class="app-bottom-sheet-body">
            </div>
        </div>
        @*OFF CANVAS FOR ADD/EDIT*@
        <div class="offcanvas offcanvas-bottom text-bg-dark"
             tabindex="-1"
             id="appOffcanvas">

            <div class="offcanvas-header">
                <h5 class="offcanvas-title" id="appOffcanvasTitle">Add</h5>
                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="offcanvas"></button>
            </div>

            <div class="offcanvas-body" id="appOffCanvasBody">
            </div>
        </div>
    </div>

    @*<footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - Trip Shared Expense Calculator - by Peter Löffler
        </div>
    </footer>*@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/ux.js" asp-append-version="true"></script>
    <script src="~/js/userMessages/toast.js" asp-append-version="true"></script>
    <script src="~/js/userMessages/modal.js" asp-append-version="true"></script>
    <script src="~/js/offline/storage.js" asp-append-version="true"></script>
    <script src="~/js/offline/editing.js" asp-append-version="true"></script>
    <script src="~/js/offline/rendering.js" asp-append-version="true"></script>
    <script src="~/js/offline/sync.js" asp-append-version="true"></script>
    <script src="~/js/offline/listeners.js" asp-append-version="true"></script>
    <script src="~/js/offline/server-status.js" asp-append-version="true"></script>
    <script src="~/js/offline/events.js" asp-append-version="true"></script>
    <script src="~/js/pwa/pwa.js" asp-append-version="true"></script>
    <script src="~/js/pwa/install.js" asp-append-version="true"></script>

    <script>
        if ("serviceWorker" in navigator) {
            navigator.serviceWorker.register("/service-worker.js")
                .then(() => console.log("Service worker registered"))
                .catch(err => console.error("Service worker failed", err));
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    @*//// MODAL /////*@
    <div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Please confirm</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body" id="confirmModalMessage">
                    Are you sure?
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button" class="btn btn-danger" id="confirmModalConfirmButton">
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>


    @*////TOAST//////*@
    <div id="toastContainer"
         class="toast-container position-fixed top-0 start-50 translate-middle-x mt-5"
         style="z-index: 1100;">
    </div>
</body>
</html>
