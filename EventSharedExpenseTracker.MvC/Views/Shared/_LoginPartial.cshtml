@using Microsoft.AspNetCore.Identity
@using EventSharedExpenseTracker.Infrastructure.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    string? userName = User.FindFirstValue("CustomUserName");
}

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
            <a asp-area="Identity"
               asp-page="/Account/Manage/Index"
               title="@userName"
               class="btn p-2 border-0 bg-transparent">

                <img src="~/icons/profile.svg"
                     alt="Profile"
                     width="30"
                     height="30" />
                <span class="small text-muted">@userName</span>
            </a>
    </li>
    <li class="nav-item">
        <form  class="form-inline" 
            asp-area="Identity" 
            asp-page="/Account/Logout" 
            asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">

                <button type="submit"
                        class="btn btn-link p-2 icon-button text-light"
                        title="Logout">

                    <img src="~/icons/logout.svg"
                         alt="Logout"
                         class="icon-light"
                         width="30"
                         height="30" />
                </button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-muted" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-muted" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>
